{
  "name": "Candidate",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05dc\u05d0"
    },
    "personal_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d0\u05d9\u05e9\u05d9"
    },
    "phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "questionnaire_data": {
      "type": "object",
      "description": "\u05e0\u05ea\u05d5\u05e0\u05d9 \u05d4\u05e9\u05d0\u05dc\u05d5\u05df \u05d4\u05de\u05dc\u05d0"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "not_passed"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05de\u05d9\u05d5\u05df"
    },
    "ramad_notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e8\u05de\"\u05d3 \u05d0\u05d9\u05ea\u05d5\u05e8"
    },
    "archived": {
      "type": "boolean",
      "default": false,
      "description": "\u05d1\u05d0\u05e8\u05db\u05d9\u05d5\u05df"
    }
  },
  "required": [
    "full_name",
    "personal_number"
  ],
  "rls": {
    "create": true,
    "read": true
  }
}