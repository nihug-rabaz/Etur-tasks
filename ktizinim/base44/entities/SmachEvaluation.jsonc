{
  "name": "SmachEvaluation",
  "type": "object",
  "properties": {
    "candidate_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d5\u05e2\u05de\u05d3"
    },
    "evaluator_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e2\u05e8\u05d9\u05da"
    },
    "evaluator_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05e2\u05e8\u05d9\u05da"
    },
    "threshold_tests": {
      "type": "object",
      "description": "\u05d7\u05dc\u05e7 \u05d0' - \u05de\u05d1\u05d7\u05e0\u05d9 \u05e1\u05e3 (\u05e2\u05d1\u05e8/\u05dc\u05d0 \u05e2\u05d1\u05e8 + \u05e6\u05d9\u05d5\u05df/\u05e0\u05ea\u05d5\u05df)"
    },
    "professional_scores": {
      "type": "object",
      "description": "\u05d7\u05dc\u05e7 \u05d1' - \u05d4\u05e2\u05e8\u05db\u05d4 \u05de\u05e7\u05e6\u05d5\u05e2\u05d9\u05ea, \u05e6\u05d9\u05d5\u05e0\u05d9\u05dd 1-5 \u05dc\u05db\u05dc \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df"
    },
    "professional_feedback": {
      "type": "object",
      "description": "\u05d7\u05dc\u05e7 \u05d1' - \u05d4\u05ea\u05e8\u05e9\u05de\u05d5\u05d9\u05d5\u05ea \u05de\u05d9\u05dc\u05d5\u05dc\u05d9\u05d5\u05ea \u05dc\u05db\u05dc \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df"
    },
    "weighted_score": {
      "type": "number",
      "description": "\u05d7\u05dc\u05e7 \u05d2' - \u05e6\u05d9\u05d5\u05df \u05de\u05e9\u05d5\u05e7\u05dc\u05dc \u05e1\u05d5\u05e4\u05d9 0-100"
    },
    "key_points": {
      "type": "string",
      "description": "\u05d7\u05dc\u05e7 \u05d3' - \u05e0\u05e7\u05d5\u05d3\u05d5\u05ea \u05de\u05e9\u05de\u05e2\u05d5\u05ea\u05d9\u05d5\u05ea \u05de\u05ea\u05d5\u05da \u05d4\u05ea\u05d4\u05dc\u05d9\u05da"
    },
    "decision": {
      "type": "string",
      "enum": [
        "\u05de\u05d5\u05de\u05dc\u05e5",
        "\u05de\u05d5\u05de\u05dc\u05e5 \u05d1\u05d4\u05e1\u05ea\u05d9\u05d9\u05d2\u05d5\u05ea",
        "\u05dc\u05d0 \u05de\u05d5\u05de\u05dc\u05e5"
      ],
      "description": "\u05d7\u05dc\u05e7 \u05d4' - \u05d4\u05d7\u05dc\u05d8\u05ea \u05d4\u05e1\u05de\u05f4\u05d7"
    },
    "decision_reasoning": {
      "type": "string",
      "description": "\u05d7\u05dc\u05e7 \u05d4' - \u05e0\u05d9\u05de\u05d5\u05e7 \u05dc\u05d4\u05d7\u05dc\u05d8\u05d4"
    }
  },
  "required": [
    "candidate_id",
    "evaluator_id"
  ]
}