{
  "name": "User",
  "type": "object",
  "properties": {
    "app_role": {
      "type": "string",
      "enum": [
        "evaluator",
        "ramad",
        "admin"
      ],
      "default": "evaluator",
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d1\u05de\u05e2\u05e8\u05db\u05ea: \u05de\u05e2\u05e8\u05d9\u05da / \u05e8\u05de\"\u05d3 \u05d0\u05d9\u05ea\u05d5\u05e8 / \u05de\u05e0\u05d4\u05dc"
    },
    "approved": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d0\u05d5\u05e9\u05e8 \u05e2\u05dc \u05d9\u05d3\u05d9 \u05de\u05e0\u05d4\u05dc"
    }
  }
}