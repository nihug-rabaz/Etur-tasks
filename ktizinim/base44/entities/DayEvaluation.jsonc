{
  "name": "DayEvaluation",
  "type": "object",
  "properties": {
    "candidate_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d5\u05e2\u05de\u05d3"
    },
    "evaluator_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e2\u05e8\u05d9\u05da"
    },
    "evaluator_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05e2\u05e8\u05d9\u05da"
    },
    "scores_data": {
      "type": "object",
      "description": "\u05e6\u05d9\u05d5\u05e0\u05d9\u05dd \u05dc\u05e4\u05d9 \u05de\u05e4\u05ea\u05d7 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df (1-10)"
    },
    "feedback_data": {
      "type": "object",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05dc\u05e4\u05d9 \u05de\u05e4\u05ea\u05d7 \u05e7\u05e8\u05d9\u05d8\u05e8\u05d9\u05d5\u05df"
    },
    "final_score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05de\u05e1\u05db\u05dd \u05e1\u05d5\u05e4\u05d9 (1-100)"
    },
    "final_feedback": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d4 \u05de\u05e1\u05db\u05de\u05ea"
    },
    "weighted_score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05de\u05e9\u05d5\u05e7\u05dc\u05dc \u05de\u05d7\u05d5\u05e9\u05d1"
    }
  },
  "required": [
    "candidate_id",
    "evaluator_id"
  ]
}