{
  "name": "PreparationDayEvaluation",
  "type": "object",
  "properties": {
    "candidate_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d5\u05e2\u05de\u05d3"
    },
    "evaluator_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05e2\u05e8\u05d9\u05da"
    },
    "evaluator_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05e2\u05e8\u05d9\u05da"
    },
    "mikra_score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05de\u05d1\u05d7\u05df \u05de\u05e7\u05e8\u05d0\u05d5\u05ea \u05d9\u05e9\u05e8\u05d0\u05dc (1-100)"
    },
    "conversation_score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05d4\u05ea\u05e0\u05e1\u05d5\u05ea \u05d1\u05d4\u05e2\u05d1\u05e8\u05ea \u05e9\u05d9\u05d7\u05d4 (1-100)"
    },
    "conversation_feedback": {
      "type": "string",
      "description": "\u05d4\u05ea\u05e8\u05e9\u05de\u05d5\u05ea \u05de\u05d9\u05dc\u05d5\u05dc\u05d9\u05ea - \u05d4\u05e2\u05d1\u05e8\u05ea \u05e9\u05d9\u05d7\u05d4"
    },
    "social_dynamics_score": {
      "type": "number",
      "description": "\u05e6\u05d9\u05d5\u05df \u05d3\u05d9\u05e0\u05de\u05d9\u05e7\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea (1-100)"
    },
    "social_dynamics_feedback": {
      "type": "string",
      "description": "\u05d4\u05ea\u05e8\u05e9\u05de\u05d5\u05ea \u05de\u05d9\u05dc\u05d5\u05dc\u05d9\u05ea - \u05d3\u05d9\u05e0\u05de\u05d9\u05e7\u05d5\u05ea \u05d7\u05d1\u05e8\u05ea\u05d9\u05d5\u05ea"
    },
    "general_impression": {
      "type": "string",
      "description": "\u05d4\u05ea\u05e8\u05e9\u05de\u05d5\u05ea \u05db\u05dc\u05dc\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05e2\u05e8\u05d9\u05da \u05de\u05d4\u05de\u05d5\u05e2\u05de\u05d3 \u05dc\u05d0\u05d5\u05e8\u05da \u05d4\u05d9\u05d5\u05dd"
    }
  },
  "required": [
    "candidate_id",
    "evaluator_id"
  ]
}